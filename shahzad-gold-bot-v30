import os, time, requests
from datetime import datetime

BOT_TOKEN = os.environ.get("BOT_TOKEN")
CHAT_ID = os.environ.get("CHAT_ID")

last_signal = ""

def get_live():
    headers = {"User-Agent": "Mozilla/5.0"}
    try:
        r = requests.get("https://data-asg.goldprice.org/dbXRates/USD", headers=headers, timeout=12).json()
        p = float(r['items'][0]['xauPrice'])
        if p > 3000: return p
    except: pass
    try:
        r = requests.get("https://api.gold-api.com/price/XAU", headers=headers, timeout=12).json()
        return float(r['price'])
    except: pass
    try:
        r = requests.get("https://api.binance.com/api/v3/ticker/price?symbol=PAXGUSDT", headers=headers, timeout=12).json()
        return float(r['price'])
    except: pass
    return None

def get_candles():
    try:
        d = requests.get("https://api.binance.com/api/v3/klines?symbol=PAXGUSDT&interval=5m&limit=100", timeout=12).json()
        return [float(c[4]) for c in d]
    except: return None

def send(t):
    try:
        requests.post(f"https://api.telegram.org/bot{BOT_TOKEN}/sendMessage", data={"chat_id": CHAT_ID, "text": t}, timeout=12)
    except: pass

def ema(a,n): return sum(a[-n:])/n
def rsi(a,per=14):
    if len(a)<per+1: return 50
    g=l=0
    for i in range(-per,0):
        d=a[i]-a[i-1]
        if d>0: g+=d
        else: l+=abs(d)
    if l==0: return 70
    return 100-(100/(1+g/l))

send("GOLD BOT V30 STARTED - 10 MIN MODE - LIVE PRICE")

while True:
    live = get_live()
    candles = get_candles()
    if live is None or candles is None:
        time.sleep(60)
        continue

    e9=ema(candles,9); e21=ema(candles,21); e50=ema(candles,50); r=rsi(candles,14)

    if abs(e9-e21)<2.0 and 46<r<54:
        msg=f"SIDEWAYS - DO NOT TRADE\nLive: {live:.2f}\nRSI: {r:.1f}"
        sig="SIDE"
    elif e9>e21 and e21>e50 and 55<r<70 and live>e9:
        msg=f"BUY SIGNAL - UP\nLive: {live:.2f}\nEntry: {live:.2f}\nSL: {live-6:.2f}\nTP: {live+4:.2f} / {live+8:.2f} / {live+14:.2f}"
        sig="BUY"
    elif e9<e21 and e21<e50 and 30<r<45 and live<e9:
        msg=f"SELL SIGNAL - DOWN\nLive: {live:.2f}\nEntry: {live:.2f}\nSL: {live+6:.2f}\nTP: {live-4:.2f} / {live-8:.2f} / {live-14:.2f}"
        sig="SELL"
    else:
        msg=f"WAIT - DO NOT TRADE NOW\nLive: {live:.2f}\nEMA: {e9:.2f}/{e21:.2f} RSI: {r:.1f}"
        sig="WAIT"

    if sig!=last_signal or sig in ["BUY","SELL"]:
        if sig in ["BUY","SELL"] or sig!=last_signal:
            # Only send if new
            if sig!=last_signal:
                send(msg)
                last_signal=sig
            elif sig in ["BUY","SELL"]:
                send(msg)
                last_signal=sig

    time.sleep(600)
