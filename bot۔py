
import os
import time
import urllib.request
import urllib.parse
import json
import math
from collections import deque

BOT_TOKEN = os.environ.get("BOT_TOKEN")
CHAT_ID = os.environ.get("CHAT_ID")

prices = deque(maxlen=100)

def send(text):
    try:
        url = f"https://api.telegram.org/bot{BOT_TOKEN}/sendMessage"
        data = urllib.parse.urlencode({"chat_id": CHAT_ID, "text": text, "parse_mode": "HTML"}).encode()
        req = urllib.request.Request(url, data=data)
        urllib.request.urlopen(req, timeout=10)
        print("Sent:", text[:50])
    except Exception as e:
        print("Send Error:", e)

def get_gold_price():
    try:
        # Free Gold Price API
        url = "https://api.gold-api.com/price/XAU"
        req = urllib.request.Request(url, headers={'User-Agent': 'Mozilla/5.0'})
        with urllib.request.urlopen(req, timeout=10) as r:
            data = json.loads(r.read().decode())
            return float(data['price'])
    except Exception as e:
        print("Price Error:", e)
        return None

def calculate_rsi(prices_list, period=14):
    if len(prices_list) < period + 1:
        return 50
    gains = 0
    losses = 0
    for i in range(1, period+1):
        change = prices_list[-i] - prices_list[-i-1]
        if change > 0: gains += change
        else: losses += abs(change)
    if losses == 0: return 85
    rs = gains / losses
    return 100 - (100 / (1 + rs))

def calculate_ema(prices_list, period):
    if len(prices_list) < period: return None
    k = 2 / (period + 1)
    ema = prices_list[0]
    for p in prices_list[1:]:
        ema = p * k + ema * (1 - k)
    return ema

print("Bot Start")
send("✅ <b>شہزاد گولڈ پرو بوٹ Live ہو گیا ہے</b>\n24 گھنٹے مارکیٹ دیکھے گا اور اچھا سگنل ملتے ہی بتائے گا۔")

while True:
    try:
        price = get_gold_price()
        if price:
            prices.append(price)
            print(f"Price: {price} | History: {len(prices)}")

            # کم از کم 30 پرائس ہوں تو سگنل چیک کرو
            if len(prices) >= 30:
                ema9 = calculate_ema(list(prices)[-20:], 9)
                ema21 = calculate_ema(list(prices)[-20:], 21)
                rsi = calculate_rsi(list(prices), 14)

                signal = None
                confidence = 0

                # BUY Condition: EMA9 > EMA21 and RSI 45-65 (uptrend start)
                if ema9 and ema21 and ema9 > ema21 and 40 < rsi < 68:
                    signal = "BUY"
                    confidence = 75 + (rsi - 50) * 0.5

                # SELL Condition: EMA9 < EMA21 and RSI 35-60
                elif ema9 and ema21 and ema9 < ema21 and 32 < rsi < 60:
                    signal = "SELL"
                    confidence = 75 + (50 - rsi) * 0.5

                if signal:
                    # SL/TP Calculation - Gold ke liye
                    sl_pips = 4.5 # $4.5
                    tp_pips = 8.5 # $8.5

                    if signal == "BUY":
                        sl = price - sl_pips
                        tp1 = price + tp_pips
                        tp2 = price + (tp_pips * 1.8)
                    else:
                        sl = price + sl_pips
                        tp1 = price - tp_pips
                        tp2 = price - (tp_pips * 1.8)

                    conf = min(92, max(65, int(confidence)))

                    msg = f"""
<b>🔥 GOLD SIGNAL FOUND 🔥</b>

<b>Action:</b> {signal} XAUUSD
<b>Entry Price:</b> {price:.2f}

<b>🛑 Stop Loss:</b> {sl:.2f}
<b>🎯 Take Profit 1:</b> {tp1:.2f}
<b>🎯 Take Profit 2:</b> {tp2:.2f}

<b>📊 Confirmation:</b> {conf}%
<b>RSI:</b> {rsi:.1f} | <b>EMA9/21:</b> {ema9:.2f}/{ema21:.2f}

<b>Time:</b> {time.strftime('%Y-%m-%d %H:%M')}
"""
                    send(msg)
                    time.sleep(1800) # سگنل کے بعد 30 منٹ رکو تاکہ سپیم نہ ہو
                else:
                    print(f"No signal - RSI {rsi:.1f}")

        time.sleep(300) # ہر 5 منٹ بعد چیک کرے گا

    except Exception as e:
        print("Loop Error:", e)
        time.sleep(30)
